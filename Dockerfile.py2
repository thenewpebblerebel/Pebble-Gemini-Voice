FROM python:2.7-slim

RUN sed -i 's/deb.debian.org/archive.debian.org/g; s|security.debian.org|archive.debian.org|g' /etc/apt/sources.list || true \
 && printf 'Acquire::Check-Valid-Until "0";\n' > /etc/apt/apt.conf.d/99no-check-valid-until \
 && apt-get update \
 && apt-get install -y --no-install-recommends build-essential git curl ca-certificates python-pip \
 && pip install --upgrade pip setuptools \
 && rm -rf /var/lib/apt/lists/*

# Install pebble-tool (legacy toolchain built for Python 2)
RUN pip install --no-cache-dir git+https://github.com/pebble/pebble-tool.git

ENV PATH="/usr/local/bin:$PATH"

WORKDIR /src
ENTRYPOINT ["/bin/bash"]

