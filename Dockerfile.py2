FROM python:2.7-slim

RUN sed -i 's/deb.debian.org/archive.debian.org/g; s|security.debian.org|archive.debian.org|g' /etc/apt/sources.list || true \
 && printf 'Acquire::Check-Valid-Until "0";\n' > /etc/apt/apt.conf.d/99no-check-valid-until \
 && apt-get update \
 && apt-get install -y --no-install-recommends build-essential git curl ca-certificates python-pip libpython2.7-dev libpython2.7-stdlib \
 && pip install --upgrade pip setuptools \
 && rm -rf /var/lib/apt/lists/*

# Install pebble-tool (legacy toolchain built for Python 2)
RUN pip install --no-cache-dir git+https://github.com/pebble/pebble-tool.git

# Ensure /usr/local/bin/python points to the installed python2 interpreter
# and fix the pebble script's shebang to use that path
RUN if [ ! -x "/usr/local/bin/python" ]; then \
		if [ -x "/usr/bin/python2.7" ]; then \
			cp /usr/bin/python2.7 /usr/local/bin/python && chmod +x /usr/local/bin/python; \
		elif [ -x "/usr/bin/python2" ]; then \
			cp /usr/bin/python2 /usr/local/bin/python && chmod +x /usr/local/bin/python; \
		fi; \
	fi && \
	sed -i '1c#! /usr/local/bin/python' /usr/local/bin/pebble && \
	chmod +x /usr/local/bin/pebble

ENV PATH="/usr/local/bin:$PATH"

WORKDIR /src
ENTRYPOINT ["/bin/bash"]
