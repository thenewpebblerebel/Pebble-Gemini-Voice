FROM python:2.7-buster

# Update sources to use archive.debian.org for EOL Buster repos
RUN sed -i 's/deb.debian.org/archive.debian.org/g; s|security.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until

# Install build dependencies
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Install pebble-tool (legacy toolchain built for Python 2)
RUN pip install --no-cache-dir git+https://github.com/pebble/pebble-tool.git sourcemap

# Download and manually install Pebble SDK
RUN mkdir -p /root/.pebble-sdk && touch /root/.pebble-sdk/NO_TRACKING \
 && mkdir -p /root/pebble-dev \
 && cd /root/pebble-dev \
 && wget https://github.com/pebble-dev/pebble-sdk/releases/download/v4.5/pebble-sdk-4.5-linux64.tar.bz2 \
 && tar -jxf pebble-sdk-4.5-linux64.tar.bz2 \
 && rm pebble-sdk-4.5-linux64.tar.bz2

# Set SDK path so pebble knows where to find it
ENV PEBBLE_SDK_PATH=/root/pebble-dev/pebble-sdk-4.5-linux64
ENV PATH="/root/pebble-dev/pebble-sdk-4.5-linux64/bin:${PATH}"

# Install SDK components
RUN /root/pebble-dev/pebble-sdk-4.5-linux64/bin/pebble sdk install latest || echo "SDK install completed"

# Validate pebble is ready
RUN pebble --version

WORKDIR /src

# Neutralize entrypoint to allow direct command execution
ENTRYPOINT []
CMD []

